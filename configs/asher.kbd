(defsrc
  esc    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv    1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab    q     w     e     r     t     y     u     i     o     p     [     ]
  caps   a     s     d     f    g     h      j     k     l     ;     '     \     ret
  lsft   z     x     c     v     b     n     m     ,     .     /     rsft
  fn     lctl  lalt  lmet              spc               rmet  ralt  lft    up down    rght
)

(deflayer base
  _      brdwn brup  mctl  sls   dtn   dnd   prev  pp    next  mute  voldwn volu
  _      _     _     _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _     _
  lrld   @a    @s    @d    @f   _     _      @j    @k    @l    @;    _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _
  @fn    _     _     _                 @spc              _     _     _      _  _       _
)

;; Keys around J go left, keys around L go right:
;;   U / O  line edge      Cmd+Left / Cmd+Right. macOS moves by screen side, so
;;                         in Hebrew (RTL) text U goes to the end of the line.
;;   M / .  tab            Ctrl+Shift+Tab / Ctrl+Tab (no letter, so the Hebrew
;;                         layout does not change it)
;;   H / ;  window half    Ctrl+Option+Left / Right, the Rectangle defaults
;;   N / /  desktop        Ctrl+Left / Ctrl+Right, the macOS defaults
;;   Y      all desktops   Ctrl+Up, Mission Control
(deflayer nav
  _      _     _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _     _     del
  _      _     _     _     _     _     C-up  M-lft up    M-rght _     _     _
  _      _     _     _     _    _     C-A-lft lft  down  rght  C-A-rght _  _     _
  _      _     _     _     _     _     C-lft C-S-tab _   C-tab C-rght _
  _      _     _     _                 _                 _     _     home   pgup pgdn    end
)

(deflayer fn
  _      f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  _      _     _     _     _     _     _     _     _     _     _     _     _     del
  _      _     _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _     _    _     _      _     _     _     _     _     _     _
  _      _     _     _     _     _     _     _     _     _     _     _
  _      _     _     _                 _                 _     _     home   pgup pgdn    end
)

(defalias
  fn (tap-hold 250 250 fn (layer-toggle fn))
)

(defcfg
  process-unmapped-keys   yes
  concurrent-tap-hold     yes
  allow-hardware-repeat   no
  ;; A tap-hold key pressed less than this many ms after another key
  ;; types its letter at once. This stops mods in fast typing ("so", "fo"),
  ;; and the letter appears on press, not on release.
  tap-hold-require-prior-idle 200
  ;; The same for chords: less than this many ms after another key,
  ;; chord keys type their letters at once and no chord can start.
  chords-v2-min-idle 200
)

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 200

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(deffakekeys
  to-base (layer-switch base)
)

(defchordsv2
  ;; A chord key waits this many ms for its partner before it types its
  ;; letter, so keep it short. Press the chord keys at the same time.
  ;; TODO: Works but caps lock LED light doesn't turn on
  (lsft rsft) caps 50 all-released ()
  (w e) esc 50 all-released ()
  (i o) bspc 50 all-released ()
  (x c) tab 50 all-released ()
  (, .) bspc 50 all-released ()
)

(defalias
  tap (multi
    ;;(layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; tap for esc, hold for lctl
  caps (tap-hold $tap-time $hold-time esc lctl)

  ;; Home row mods. A key is a mod only after it is held $hold-time ms.
  ;; A press of another key does not make it a mod early, so a fast overlap
  ;; ("for", "di") types letters. A same-hand key press makes it a letter at once.
  a (tap-hold-tap-keys $tap-time $hold-time (multi a @tap) lsft $left-hand-keys)
  s (tap-hold-tap-keys $tap-time $hold-time (multi s @tap) lctl $left-hand-keys)
  d (tap-hold-tap-keys $tap-time $hold-time (multi d @tap) lalt $left-hand-keys)
  f (tap-hold-tap-keys $tap-time $hold-time (multi f @tap) lmet $left-hand-keys)
  j (tap-hold-tap-keys $tap-time $hold-time (multi j @tap) rmet $right-hand-keys)
  k (tap-hold-tap-keys $tap-time $hold-time (multi k @tap) ralt $right-hand-keys)
  l (tap-hold-tap-keys $tap-time $hold-time (multi l @tap) rctl $right-hand-keys)
  ; (tap-hold-tap-keys $tap-time $hold-time (multi ; @tap) rsft $right-hand-keys)
  spc (tap-hold $tap-time $hold-time spc (layer-toggle nav))

  fnl (tap-hold 200 200 fn (layer-toggle fn))

  ;; macOS function key glyphs
  mc C-up ;; Mission Control
  sls M-spc ;; Spotlight Search
  dtn S-C-A-M-f5 ;; Dictation
  dnd S-C-A-M-f6 ;; Do Not Disturb
  lp S-C-A-M-l ;; Launchpad
)
